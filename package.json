{
  "name": "@jsdevlab/valibot",
  "version": "1.0.1",
  "private": false,
  "description": "Generate deterministic initialization data and seedable mock data from valibot schemas, with end-to-end type inference.",
  "keywords": [
    "valibot",
    "schema",
    "mock",
    "mock-data",
    "fake",
    "faker",
    "test-data",
    "fixtures",
    "seeded",
    "data-generation",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jsdevlab/valibot.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "README.zh-CN.md"],
  "scripts": {
    "build": "rslib && node scripts/postbuild.mjs",
    "changeset": "changeset",
    "check": "biome check",
    "check:fix": "biome check --write",
    "coverage": "rstest --coverage",
    "dev": "rslib --watch",
    "format": "biome format --write",
    "prepare": "simple-git-hooks",
    "release": "changeset publish",
    "test": "tsc --noEmit && tsc --noEmit -p tsconfig.typetests.json && rstest",
    "test:types": "tsc --noEmit -p tsconfig.typetests.json",
    "test:watch": "rstest --watch",
    "version": "changeset version"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check:fix",
    "pre-push": "pnpm test"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@rslib/core": "^0.23.2",
    "@rstest/adapter-rslib": "^0.11.9",
    "@rstest/core": "^0.11.9",
    "@rstest/coverage-v8": "^0.11.9",
    "@types/node": "^24.13.3",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "valibot": "^1.5.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=20.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.19.0 <27.0.0",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
